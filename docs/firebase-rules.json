{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9-]{3,32}$/)",
        "users": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $room.matches(/^[a-z0-9-]{3,32}$/)",
            ".validate": "newData.hasChildren(['name', 'look', 'zone', 'seat', 'seen'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24 && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains('{') && !newData.val().contains('}') && !newData.val().contains('[') && !newData.val().contains(']')" },
            "look": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0" },
            "zone": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4 && newData.val() % 1 === 0" },
            "seat": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 5 && newData.val() % 1 === 0" },
            "seen": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "drink": {
              ".validate": "newData.hasChildren(['id', 'name', 'cup', 'pour'])",
              "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)" },
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32 && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains('{') && !newData.val().contains('}') && !newData.val().contains('[') && !newData.val().contains(']')" },
              "cup": { ".validate": "newData.isString() && newData.val().matches(/^(coupe|highball|martini|rocks|shot|snifter|wine)$/)" },
              "pour": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
              "garnish": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{0,16}$/)" },
              "ice": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "chat": {
          ".indexOn": ["t"],
          "$msg": {
            ".write": "auth != null && !data.exists() && $room.matches(/^[a-z0-9-]{3,32}$/)",
            ".validate": "newData.hasChildren(['uid', 'kind', 'p', 't'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "kind": { ".validate": "newData.val() === 'say' || newData.val() === 'cheers'" },
            "p": { ".validate": "newData.isString() && newData.val().matches(/^(hi|cheers|music|advice|wow|thanks|laugh|bye)$/)" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "stats": {
      "$bar": {
        "$day": {
          "$ev": {
            ".write": "auth != null && $bar.matches(/^[a-z0-9-]{3,32}$/) && $day.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && $ev.matches(/^(menu_open|event_open|pass_issued|story_share|invite_share|treat_open|booking_click|booking_send)$/)",
            "n": { ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.parent().child('u').child(auth.uid).val() === true && !data.parent().child('u').child(auth.uid).exists()" },
            "u": {
              "$uid": { ".validate": "$uid === auth.uid && !data.exists() && newData.val() === true && newData.parent().parent().child('n').val() === (data.parent().parent().child('n').exists() ? data.parent().parent().child('n').val() : 0) + 1" }
            },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
